{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Allows the EDWIN desktop application to run its backend sidecar.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    {
      "identifier": "shell:allow-spawn",
      "allow": [
        {
          "name": "binaries/EDWINBackend",
          "sidecar": true,
          "args": true
        }
      ]
    }
  ]
}
